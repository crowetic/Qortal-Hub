# Export these variables in the launching shell, or use a systemd EnvironmentFile.
QORTAL_HUB_API_HOST=127.0.0.1
QORTAL_HUB_API_PORT=3192
QORTAL_HUB_API_AUTH_URL=http://127.0.0.1:3191
QORTAL_HUB_CORE_URL=http://127.0.0.1:12391
QORTAL_HUB_RNS_PORT=37438
QORTAL_HUB_RNS_CONTROL_PORT=37439
QORTAL_HUB_MAX_ACCOUNTS=16
QORTAL_HUB_ACCOUNT_IDLE_MS=600000
# Optional: restrict to these joined groups; omit to use all joined groups.
# QORTAL_HUB_API_GROUP_IDS=716,42
# QORTAL_HUB_DATA_DIR=/var/lib/qortal-hub-daemon
# QORTAL_HUB_API_ORIGINS=https://hub.qortal.link
# Optional hosted browser access (normal Hub login; no External Auth needed).
# QORTAL_HUB_BROWSER_ENABLED=1
# QORTAL_HUB_BROWSER_PORT=3193
# QORTAL_HUB_CUSTOM_RNS_CONFIG=1
